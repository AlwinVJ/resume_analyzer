# Groq API configuration. Get a free key at https://console.groq.com/keys
# Copy this file to .env and put your real key there. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional overrides (defaults shown)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT_S=60
# LLM_MAX_TOKENS=4096
# LLM_REASONING_EFFORT=low
# LLM_MAX_RETRIES=2
# LLM_MAX_RETRY_WAIT_S=20
